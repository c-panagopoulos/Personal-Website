PORT=3000

DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# Optional — free-tier fallback used automatically if Groq's request fails
# (e.g. daily quota exhausted). Get a key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemma-4-31b-it

RETRIEVAL_TOP_K=6

# Optional — falls back to a sensible default in server/src/routes/chat.js if unset.
SYSTEM_PROMPT=
